[
  {
    "name": "usgs",
    "type": "api",
    "description": "USGS water level data API",
    "endpoint": "https://waterdata.usgs.gov/nwis",
    "auth": "none",
    "schedule": "hourly"
  },
  {
    "name": "open_meteo",
    "type": "api",
    "description": "Open-Meteo weather data API",
